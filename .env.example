# ---------------------------------------------------------------------------
# RAG-Cyber configuration. Copy this file to ".env" (same folder) and fill it in.
# Never commit your real .env file.
# ---------------------------------------------------------------------------

# --- Neo4j (required) ------------------------------------------------------
# Local:  bolt://localhost:7687      Aura: neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- NVD (optional but recommended: 10x higher rate limit) -----------------
# Request a free key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Optional: limit the FIRST load to CVEs published on/after this date (YYYY-MM-DD).
# Leave empty to load the full NVD catalogue (300k+ CVEs; exceeds Aura Free limits).
NVD_SYNC_START_DATE=

# --- LLM (answer wording) --------------------------------------------------
# none      -> deterministic extractive answers built from the evidence (no key needed)
# anthropic -> Claude via the Anthropic API (LLM_MODEL default: claude-opus-5-5)
# openai    -> any OpenAI-compatible API (OpenAI, LM Studio, ...); set LLM_BASE_URL for local servers
# ollama    -> local Ollama (LLM_MODEL default: llama3, LLM_BASE_URL default: http://localhost:11434)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- Embeddings ------------------------------------------------------------
# local  -> built-in hashing embedder (no key, lexical similarity; fine for development)
# openai -> OpenAI-compatible /embeddings endpoint (EMBEDDING_MODEL default: text-embedding-3-small)
# ollama -> local Ollama (EMBEDDING_MODEL default: nomic-embed-text)
# After changing provider/model run:  python -m backend.manage reembed
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
# Set to false to skip CVE embeddings (saves space/cost; CVE lookup by ID still works)
EMBED_CVES=true

# --- Scheduling ------------------------------------------------------------
# MITRE sources (CWE, CAPEC, ATT&CK) + reference documents
UPDATE_INTERVAL_HOURS=24
# NVD incremental updates
NVD_UPDATE_INTERVAL_HOURS=2
SCHEDULER_ENABLED=true
# Synchronise all sources in the background when the server starts
RUN_INITIAL_SYNC=true

# --- API -------------------------------------------------------------------
# Required to use POST /api/admin/sync (sent as the X-Admin-Key header). Choose a long random value.
ADMIN_API_KEY=
# Origins allowed to call the API when the frontend is hosted separately
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

LOG_LEVEL=INFO

# --- tuned retrieval / generation parameters -----------------------------------
# Path of a JSON file written by `python -m backend.experiments.run select ...`.
# Empty = the built-in defaults.
TUNING_CONFIG=
